{
  "name": "@acp3/module-system",
  "description": "Provides the system module for the ACP3 CMS.",
  "scripts": {
    "build": "gulp",
    "css-lint": "stylelint \"**/*.{css,scss}\" --cache --cache-location .stylelintcache --rd",
    "css-lint:fix": "npm run css-lint -- --fix",
    "eslint": "eslint -c eslint.config.mjs --cache --cache-location=.eslintcache .",
    "eslint:fix": "npm run eslint -- --fix",
    "prettier": "prettier --check --cache **/*.{js,cjs,mjs,json,md,yml}",
    "prettier:fix": "prettier --write --cache **/*.{js,cjs,mjs,json,md,yml}",
    "lint-all": "concurrently \"npm:prettier:fix\" \"npm:css-lint:fix\" \"npm:eslint:fix\" --kill-others-on-fail --group",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/ACP3/cms.git"
  },
  "author": "Tino Goratsch <mail@acp3-cms.net>",
  "license": "GPL-2.0-or-later",
  "bugs": {
    "url": "https://gitlab.com/ACP3/cms/issues"
  },
  "homepage": "https://www.acp3-cms.net",
  "private": true,
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.21.0",
    "autoprefixer": "^10.4.21",
    "browserslist": "^4.25.1",
    "concurrently": "^9.2.0",
    "css-loader": "^7.1.2",
    "cssnano": "^7.0.7",
    "del": "^8.0.0",
    "esbuild": "^0.25.5",
    "esbuild-loader": "^4.3.0",
    "esbuild-plugin-browserslist": "^1.0.1",
    "eslint": "^9.29.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.5.1",
    "globals": "^16.2.0",
    "globby": "^14.1.0",
    "gulp": "^4.0.2",
    "gulp-bump": "^3.2.0",
    "gulp-change": "^1.0.2",
    "gulp-dependents": "^1.2.5",
    "gulp-eslint-new": "^2.4.0",
    "gulp-plumber": "^1.2.1",
    "gulp-postcss": "^10.0.0",
    "gulp-rename": "^2.1.0",
    "gulp-sass": "^6.0.1",
    "gulp-sharp-responsive": "^0.4.1",
    "gulp-stylelint-esm": "^3.0.0",
    "husky": "^9.1.7",
    "js-yaml": "^4.1.0",
    "lint-staged": "^16.1.2",
    "postcss": "^8.5.6",
    "prettier": "^3.6.1",
    "sass-embedded": "~1.78.0",
    "semver": "^7.7.2",
    "simple-git": "^3.28.0",
    "style-loader": "^4.0.0",
    "stylelint": "^16.21.0",
    "stylelint-config-twbs-bootstrap": "^16.1.0",
    "stylelint-prettier": "^5.0.3",
    "terser-webpack-plugin": "^5.3.14",
    "webpack-stream": "^7.0.0",
    "yargs": "^18.0.0"
  },
  "dependencies": {
    "@fancyapps/fancybox": "^3.5.7",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.7",
    "core-js": "^3.43.0",
    "datatables.net": "^2.0.2",
    "datatables.net-bs5": "^2.3.2",
    "jquery": "^3.7.1",
    "js-cookie": "^3.0.5",
    "photoswipe": "^5.4.4"
  }
